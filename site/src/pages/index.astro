---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/xavidop/tamesu";

// Bodies are trusted, static HTML so keys can render as <code>.
const targets = [
  {
    tag: "browser",
    title: "Web apps",
    body: "Agentic <code>goal</code> and <code>expect</code> steps drive Chromium over CDP; deterministic actions, screenshots and a HAR for every run.",
  },
  {
    tag: "rest",
    title: "REST agents",
    body: "A simulated user talks to your HTTP agent turn by turn (JSON, SSE or WebSocket); JSONPaths read the reply, tool calls and the end of the session.",
  },
  {
    tag: "livekit",
    title: "Voice agents",
    body: "tamesu joins a LiveKit room as a caller, in text or real audio: TTS in, VAD and STT out, interruptions, silence and background noise included.",
  },
  {
    tag: "sip",
    title: "Phone agents",
    body: "Real calls through a LiveKit SIP service and your trunk: dial out or get called, press DTMF, follow IVR scripts, measure ring and setup time.",
  },
  {
    tag: "realtime",
    title: "OpenAI Realtime",
    body: "The Realtime protocol over a websocket, in text or audio: the API itself with your instructions and tools, or your own server speaking its events.",
  },
  {
    tag: "grpc",
    title: "gRPC agents",
    body: "A small turn API (<code>Converse</code> stream or unary <code>Turn</code>) any gRPC service can implement, with the same latency metrics as REST.",
  },
  {
    tag: "pipecat",
    title: "Pipecat bots",
    body: "The websocket transport of a Pipecat bot: protobuf audio frames and RTVI messages, text or real audio, with the bot's words and timing.",
  },
  {
    tag: "twilio",
    title: "Twilio agents",
    body: "tamesu plays Twilio's side of Media Streams: μ-law media, DTMF, marks and clear against your stream URL, so a phone agent is tested with no number, trunk or call.",
  },
  {
    tag: "mcp",
    title: "MCP servers",
    body: "An MCP server's tools, driven by a model: descriptions, argument schemas, answers and errors tested as an agent built on the server would meet them.",
  },
  {
    tag: "a2a",
    title: "A2A agents",
    body: "An agent speaking the Agent2Agent protocol: its card and skills, message/send or a streamed task, input-required turns and artifacts, judged like any other agent.",
  },
  {
    tag: "voice",
    title: "Any voice websocket",
    body: "A websocket that carries audio, PCM or G.711, binary or base64 in JSON, with the protocol's control messages read by JSONPath: hosted voice platforms and in-house stacks, from YAML.",
  },
  {
    tag: "model",
    title: "Prompts, no server yet",
    body: "A system prompt and its tool definitions straight against a model; tool calls are answered from the suite, so a prompt is regression-tested before the agent exists.",
  },
];

const pillars = [
  {
    tag: "assertions",
    title: "One assertion model",
    body: "<code>judge</code> rubrics with structured output next to <code>contains</code>, <code>regex</code>, <code>tool_called</code>, <code>json_path</code> and <code>metric</code>, on the whole test or one turn.",
  },
  {
    tag: "genkit",
    title: "All AI through Genkit",
    body: "The simulated user, the judges and speech are Genkit flows. Switch Gemini, Claude, GPT or Ollama with one line and trace every run in the Developer UI.",
  },
  {
    tag: "mamori",
    title: "Secrets done right",
    body: "Keys are mamori refs (<code>env:</code>, <code>aws-sm://</code>, <code>vault://</code>, <code>op://</code>), resolved once per run, revealed at the point of use and redacted everywhere else.",
  },
];
// The snippets are rendered with set:html: Astro would otherwise read the
// {{secrets.X}} templates as expressions.
const quickYaml = `<span class="k">suite</span>: support-agent
<span class="k">secrets</span>:
  <span class="k">API_TOKEN</span>: <span class="s">env:SUPPORT_API_TOKEN</span>       <span class="c"># a mamori ref, never a value</span>
<span class="k">targets</span>:
  <span class="k">api</span>:
    <span class="k">type</span>: <span class="s">rest</span>
    <span class="k">url</span>: <span class="s">https://api.example.com/v1/chat</span>
    <span class="k">headers</span>: { <span class="k">Authorization</span>: <span class="s">"Bearer {{secrets.API_TOKEN}}"</span> }
    <span class="k">request</span>: { <span class="k">body</span>: { <span class="k">session_id</span>: <span class="s">"{{session}}"</span>, <span class="k">message</span>: <span class="s">"{{message}}"</span> } }
    <span class="k">response</span>: { <span class="k">text</span>: <span class="s">$.reply</span>, <span class="k">tool_calls</span>: <span class="s">$.tool_calls[*].name</span> }
<span class="k">tests</span>:
  - <span class="k">name</span>: refund policy question
    <span class="k">target</span>: api
    <span class="k">persona</span>: { <span class="k">name</span>: Marta, <span class="k">style</span>: <span class="s">"polite, slightly confused"</span> }
    <span class="k">scenario</span>: { <span class="k">goal</span>: <span class="s">"Find out if you can return shoes bought 40 days ago"</span>, <span class="k">max_turns</span>: 8 }
    <span class="k">assert</span>:
      - <span class="f">judge</span>: <span class="s">"The agent states the 30-day return policy and does not promise an exception"</span>
      - <span class="f">not_contains</span>: <span class="s">"I'm just an AI"</span>
      - <span class="f">metric</span>: { <span class="k">name</span>: turn_latency_ms_p95, <span class="k">lt</span>: 4000 }`;
const quickShell = `<span class="c">$</span> tamesu init
<span class="c">$</span> tamesu validate
1 suite, 2 tests, 0 errors, 0 warnings
<span class="c">$</span> tamesu doctor
ok   config: tamesu.yaml (version 1)
ok   suites: 1 file, 2 tests
ok   secret API_TOKEN: env (link 1 of 1)`;
---

<Layout>
  <section class="hero section">
    <div class="wrap hero__grid">
      <div class="hero__inner">
        <img class="hero__logo" src={`${base}brand/tamesu-logo.svg`} alt="" width="96" height="96" />
        <p class="eyebrow">試す tamesu · to try, to test</p>
        <h1>Your agents, tested like users would.</h1>
        <p class="hero__lede">
          Describe a test the way you would brief a colleague: a persona, a goal and what a good
          outcome looks like. A simulated user then talks to your agent or drives your web app, and
          deterministic checks and LLM judges grade the result.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={`${base}docs/install/`}>Install</a>
          <a class="btn btn--ghost" href={`${base}docs/`}>Read the docs</a>
          <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener">View on GitHub</a>
        </div>
        <p class="hero__install"><code>brew install xavidop/tap/tamesu</code></p>
        <p class="hero__note">Homebrew is macOS only; on Linux and Windows, use a package or a release binary.</p>
        <p class="hero__status">
          One YAML schema for <code>browser</code>, <code>rest</code>, <code>grpc</code>,
          <code>livekit</code>, <code>sip</code>, <code>twilio</code>, <code>realtime</code>,
          <code>pipecat</code>, <code>voice</code>, <code>model</code>, <code>mcp</code> and <code>a2a</code> targets, validated with file and line numbers.
          <code>tamesu doctor</code> resolves every secret through mamori and checks the setup.
        </p>
      </div>
      <figure class="window">
        <div class="window__bar" aria-hidden="true">
          <span class="window__dot"></span>
          <span class="window__dot"></span>
          <span class="window__dot"></span>
          <span class="window__title">tamesu init && tamesu validate</span>
        </div>
        <img
          class="demo__gif"
          src={`${base}demo.gif`}
          alt="tamesu init, validate, list and doctor in a terminal"
          width="1100"
          height="600"
        />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">Ten targets, one model</p>
        <h2>The same test for a prompt, a chatbot, a voice agent, a phone line, a realtime API and a web flow</h2>
      </div>
      <div class="targets">
        {targets.map((p) => (
          <div class="card pillar">
            <p class="pillar__tag">{p.tag}</p>
            <h3>{p.title}</h3>
            <p set:html={p.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">Quick start</p>
        <h2>A persona, a goal, and what good looks like</h2>
      </div>
      <div class="quick">
        <pre class="code" set:html={quickYaml} />
        <div class="quick__side">
          <pre class="code" set:html={quickShell} />
          <p>
            <a href={`${base}docs/quickstart/`}>Follow the quick start</a> or read the
            <a href={`${base}docs/suites/`}>YAML reference</a>, generated from the schema.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">Why tamesu</p>
        <h2>Built for CI, honest about AI</h2>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="card pillar">
            <p class="pillar__tag">{p.tag}</p>
            <h3>{p.title}</h3>
            <p set:html={p.body} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) 2rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .hero__inner {
    max-width: 760px;
  }
  .hero__logo {
    display: block;
    width: 64px;
    height: 64px;
    margin-bottom: 1.2rem;
    border-radius: 16px;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 2.4vw, 3.7rem);
    line-height: 1.04;
    margin: 0.4rem 0 1.2rem;
  }
  .hero__lede {
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 52ch;
    margin: 0 0 1.8rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }
  .hero__install {
    margin: 0 0 1.2rem;
  }
  .hero__install code {
    display: inline-block;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--code-bg);
    font-size: 0.95rem;
  }
  .hero__note {
    color: var(--muted);
    font-size: var(--step--1);
    margin: -0.6rem 0 1.2rem;
  }
  .hero__status {
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .hero__status code {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-3);
    color: var(--rail-deep);
  }
  .hero__status a {
    color: var(--rail-deep);
    text-decoration: underline;
    text-decoration-color: var(--rail);
    text-underline-offset: 3px;
  }
  .window {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #1e1e2e;
    box-shadow: 0 24px 48px -16px rgba(var(--shadow), 0.35);
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.9rem;
    background: #181825;
    border-bottom: 1px solid #313244;
  }
  .window__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #f38ba8;
  }
  .window__dot:nth-child(2) {
    background: #f9e2af;
  }
  .window__dot:nth-child(3) {
    background: #a6e3a1;
  }
  .window__title {
    flex: 1;
    margin-right: 2.4rem;
    color: #a6adc8;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    text-align: center;
  }
  .demo__gif {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Four target cards: two by two, then one column. */
  .targets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  @media (max-width: 600px) {
    .targets {
      grid-template-columns: 1fr;
    }
  }
  /* Three pillars: three columns, then one. */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }
  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  .pillar h3 {
    font-size: var(--step-1);
    margin: 0 0 0.5rem;
  }
  .pillar p {
    color: var(--muted);
    margin: 0;
  }
  .pillar .pillar__tag {
    margin: 0 0 0.9rem;
    color: var(--signal);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pillar :global(code) {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-3);
    color: var(--rail-deep);
    font-size: 0.88em;
    white-space: nowrap;
  }
  .quick {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
  }
  @media (max-width: 960px) {
    .quick {
      grid-template-columns: 1fr;
    }
  }
  .quick pre.code {
    font-size: 0.82rem;
  }
  .quick__side {
    display: grid;
    gap: 1rem;
  }
  .quick__side p {
    color: var(--muted);
    margin: 0;
  }
  .quick__side a {
    color: var(--rail-deep);
    text-decoration: underline;
    text-decoration-color: var(--rail);
    text-underline-offset: 3px;
  }
</style>
