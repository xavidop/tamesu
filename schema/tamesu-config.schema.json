{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xavidop.github.io/tamesu/schema/tamesu-config.schema.json",
  "$defs": {
    "Assertion": {
      "properties": {
        "judge": {
          "$ref": "#/$defs/Judge"
        },
        "contains": {
          "type": "string",
          "description": "The agent transcript contains this text."
        },
        "not_contains": {
          "type": "string"
        },
        "regex": {
          "type": "string",
          "description": "A regular expression the agent transcript matches."
        },
        "not_regex": {
          "type": "string",
          "description": "A regular expression no agent turn matches."
        },
        "json_path": {
          "$ref": "#/$defs/JSONPathAssertion",
          "description": "rest only."
        },
        "status": {
          "type": "integer",
          "description": "rest only: the HTTP status of every turn."
        },
        "tool_called": {
          "$ref": "#/$defs/ToolCall"
        },
        "tool_not_called": {
          "$ref": "#/$defs/ToolCall"
        },
        "tool_sequence": {
          "$ref": "#/$defs/ToolSequence",
          "description": "The agent called these tools in this order (a subsequence of its calls; exact for the whole list)."
        },
        "dtmf_received": {
          "$ref": "#/$defs/DTMFAssertion",
          "description": "sip and livekit audio: digits the agent sent."
        },
        "call_ended_by": {
          "$ref": "#/$defs/StringList",
          "description": "sip: agent caller timeout error no_answer busy."
        },
        "transferred_to": {
          "$ref": "#/$defs/Matches",
          "description": "sip: target of a SIP REFER."
        },
        "evaluator": {
          "$ref": "#/$defs/Evaluator"
        },
        "metric": {
          "$ref": "#/$defs/MetricAssertion"
        },
        "turns": {
          "$ref": "#/$defs/IntCompare",
          "description": "Number of agent turns."
        },
        "captured": {
          "$ref": "#/$defs/CapturedAssertion",
          "description": "A value captured during the run exists and equals or matches."
        },
        "golden": {
          "$ref": "#/$defs/GoldenAssertion",
          "description": "The agent's turns against reference turns: a file next to the suite or inline turns; exact / similar / judge."
        },
        "custom": {
          "type": "string",
          "description": "A Go-registered assertion by name."
        },
        "pack": {
          "type": "string",
          "description": "A reusable assertion set: a built-in red-team pack (prompt_injection / pii_leakage / system_prompt_leakage) or one of the suite's packs; it expands into its assertions when the suite loads."
        },
        "on_turn": {
          "$ref": "#/$defs/OnTurn"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "BaselineConfig": {
      "properties": {
        "dir": {
          "type": "string",
          "description": "Where tamesu baseline save keeps the baseline summary; default .tamesu/baseline."
        },
        "max_latency_increase_pct": {
          "type": "number",
          "description": "A test's p95 latency metrics may grow this much over the baseline (median over repeats); default 20; 0 disables."
        },
        "max_cost_increase_pct": {
          "type": "number",
          "description": "A test's llm_cost_usd may grow this much; default 50; 0 disables."
        },
        "fail_on_new_failures": {
          "type": "boolean",
          "description": "A test that passed in the baseline and fails now is a regression; default true."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Budgets": {
      "properties": {
        "max_cost_usd": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CacheConfig": {
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory of the caches (browser action plans and llm answers); default .tamesu/cache."
        },
        "llm": {
          "type": "boolean",
          "description": "Cache the simulator's turns and the judge's verdicts by request (default true); false calls the models every time."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CapturedAssertion": {
      "properties": {
        "name": {
          "type": "string"
        },
        "equals": {
          "type": "string"
        },
        "matches": {
          "type": "string",
          "description": "A regular expression the value must match."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "DTMFAssertion": {
      "properties": {
        "equals": {
          "type": "string",
          "description": "The exact digits such as 1234#."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "equals"
      ]
    },
    "Defaults": {
      "properties": {
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "repeat": {
          "type": "integer",
          "description": "Times each test runs."
        },
        "retries": {
          "type": "integer"
        },
        "pass_threshold": {
          "type": "number",
          "description": "Fraction of repeats that must pass (0 to 1]."
        },
        "max_goal_steps": {
          "type": "integer",
          "description": "Browser: the most actions the agent may take per goal step; default 15."
        },
        "assert": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "type": "array",
          "description": "Assertions every test must pass (results named defaults/\u003cname\u003e); a suite's entries run after the project's. Packs apply."
        },
        "slo": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object",
          "description": "Maximum per metric on every test such as turn_latency_ms_p95: 3000 or llm_cost_usd: 0.05 (results named slo/\u003cmetric\u003e); a metric a test does not measure passes."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Duration": {
      "type": "string",
      "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "A duration such as 30s, 3m or 1h30m."
    },
    "Evaluator": {
      "oneOf": [
        {
          "type": "string",
          "description": "The evaluator name."
        },
        {
          "properties": {
            "name": {
              "type": "string",
              "description": "Genkit evaluator name such as genkitEval/faithfulness."
            },
            "min": {
              "type": "number",
              "description": "Minimum score to pass (0 to 1)."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "name"
          ]
        }
      ]
    },
    "Genkit": {
      "properties": {
        "plugins": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Genkit plugins to initialise: googlegenai anthropic openai ollama deepgram elevenlabs."
        },
        "dev_ui": {
          "type": "boolean",
          "description": "Export traces to the Genkit Developer UI."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "GoldenAssertion": {
      "properties": {
        "file": {
          "type": "string",
          "description": "A JSON file next to the suite: an array of agent turns or a transcript.json; written by tamesu run --update-golden."
        },
        "turns": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Inline reference turns instead of a file."
        },
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "similar",
            "judge"
          ],
          "description": "exact (normalised text) / similar (word overlap at least min; the default) / judge (the judge decides whether each turn means the same)."
        },
        "min": {
          "type": "number",
          "description": "similar: the minimum word overlap (0 to 1); default 0.8."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HTTPTrigger": {
      "properties": {
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "body": true,
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url"
      ]
    },
    "Hook": {
      "properties": {
        "command": {
          "type": "string",
          "description": "A shell command (sh -c)."
        },
        "http": {
          "$ref": "#/$defs/HTTPTrigger",
          "description": "An HTTP request; a status of 400 or more fails the hook."
        },
        "timeout": {
          "$ref": "#/$defs/Duration",
          "description": "How long the hook may take; default 60s."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Hooks": {
      "properties": {
        "before_all": {
          "items": {
            "$ref": "#/$defs/Hook"
          },
          "type": "array",
          "description": "Run once before the suite's first test (the project's first)."
        },
        "after_all": {
          "items": {
            "$ref": "#/$defs/Hook"
          },
          "type": "array",
          "description": "Run once after the suite's last test."
        },
        "before_each": {
          "items": {
            "$ref": "#/$defs/Hook"
          },
          "type": "array",
          "description": "Run before every run of every test; a failure is an infrastructure error for that run."
        },
        "after_each": {
          "items": {
            "$ref": "#/$defs/Hook"
          },
          "type": "array",
          "description": "Run after every run; a failure is logged and does not change the run's result."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IntCompare": {
      "properties": {
        "lt": {
          "type": "integer"
        },
        "lte": {
          "type": "integer"
        },
        "gt": {
          "type": "integer"
        },
        "gte": {
          "type": "integer"
        },
        "eq": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JSONPathAssertion": {
      "properties": {
        "path": {
          "type": "string",
          "description": "JSONPath into the response body such as $.status."
        },
        "equals": {
          "description": "The value the path must equal."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path"
      ]
    },
    "Judge": {
      "oneOf": [
        {
          "type": "string",
          "description": "The rubric; the judge model and a binary scale are the defaults."
        },
        {
          "properties": {
            "rubric": {
              "type": "string",
              "description": "What the judge checks in plain language."
            },
            "model": {
              "type": "string",
              "description": "Genkit model reference; defaults to models.judge."
            },
            "scale": {
              "type": "string",
              "enum": [
                "binary",
                "1-5"
              ],
              "description": "binary (pass or fail) or 1-5 with min."
            },
            "min": {
              "type": "number",
              "description": "Minimum score to pass on the 1-5 scale."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "rubric"
          ]
        }
      ]
    },
    "LiveKitConfig": {
      "properties": {
        "max_concurrent_rooms": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Matches": {
      "properties": {
        "matches": {
          "type": "string",
          "description": "A regular expression such as ^sip:billing@."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "matches"
      ]
    },
    "MetricAssertion": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Metric name such as turn_latency_p95_ms."
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "eq": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "Models": {
      "properties": {
        "default": {
          "type": "string"
        },
        "judge": {
          "type": "string"
        },
        "browser_agent": {
          "type": "string"
        },
        "simulator": {
          "type": "string"
        },
        "scenario_generator": {
          "type": "string"
        },
        "credentials": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Plugin name to {{secrets.NAME}} when the secret is not named conventionally."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OnTurn": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "enum": [
            "last"
          ]
        }
      ],
      "description": "Evaluate the assertion on one agent turn: a 1-based number or last."
    },
    "SIPConfig": {
      "properties": {
        "livekit_url": {
          "type": "string",
          "description": "LiveKit server with the SIP service (ws:// or wss://)."
        },
        "outbound_trunk_id": {
          "type": "string",
          "description": "The LiveKit outbound trunk tamesu dials through (tamesu sip setup prints it)."
        },
        "inbound_trunk_id": {
          "type": "string",
          "description": "The LiveKit inbound trunk for calls to inbound_number (informational; tamesu sip setup prints it)."
        },
        "dispatch_rule_id": {
          "type": "string",
          "description": "The dispatch rule that routes inbound calls into inbound_room (informational)."
        },
        "inbound_number": {
          "type": "string",
          "description": "The number your trunk routes to tamesu"
        },
        "inbound_room": {
          "type": "string",
          "description": "The room the dispatch rule routes inbound calls into; default tamesu-sip-inbound."
        },
        "max_concurrent_calls": {
          "type": "integer"
        },
        "allowed_numbers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "E.164 patterns tamesu may dial such as +1800555*; required when a target's to is a template."
        },
        "trunk": {
          "$ref": "#/$defs/SIPTrunk"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SIPTrunk": {
      "properties": {
        "address": {
          "type": "string",
          "description": "The provider's SIP host such as sip.twilio.com or pbx.example.com:5060."
        },
        "numbers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "The trunk's numbers in E.164: caller IDs for outbound calls and the numbers of the inbound trunk."
        },
        "inbound_numbers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Overrides numbers for the inbound trunk."
        },
        "auth_username": {
          "type": "string",
          "description": "Outbound authentication; use {{secrets.NAME}}."
        },
        "auth_password": {
          "type": "string",
          "description": "Outbound authentication; use {{secrets.NAME}}."
        },
        "transport": {
          "type": "string",
          "enum": [
            "auto",
            "udp",
            "tcp",
            "tls"
          ]
        },
        "allowed_addresses": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "IPs"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "address"
      ]
    },
    "SlackConfig": {
      "properties": {
        "webhook": {
          "type": "string",
          "description": "The incoming webhook URL as {{secrets.NAME}}."
        },
        "only_failures": {
          "type": "boolean",
          "description": "Post only when a test failed or errored or the run regressed against the baseline."
        },
        "link": {
          "type": "string",
          "description": "A link put at the end of the message such as the job URL; templates and ${VAR} apply."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Speech": {
      "properties": {
        "stt": {
          "$ref": "#/$defs/SpeechModel"
        },
        "tts": {
          "$ref": "#/$defs/SpeechModel"
        },
        "vad": {
          "$ref": "#/$defs/VADConfig"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SpeechModel": {
      "properties": {
        "model": {
          "type": "string",
          "description": "Genkit model reference such as deepgram/nova-3 or googleai/gemini-2.5-flash-preview-tts."
        },
        "language": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "StringList": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "ToolCall": {
      "oneOf": [
        {
          "type": "string",
          "description": "The tool name."
        },
        {
          "properties": {
            "name": {
              "type": "string",
              "description": "Tool name as the target reports it."
            },
            "args": {
              "type": "object",
              "description": "Argument values that must match (a subset of the call's arguments)."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "name"
          ]
        }
      ]
    },
    "ToolSequence": {
      "properties": {
        "calls": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Tool names in the order they must be called."
        },
        "exact": {
          "type": "boolean",
          "description": "The run's tool calls must be exactly this list; default a subsequence."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "calls"
      ]
    },
    "VADConfig": {
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "energy",
            "silero"
          ],
          "description": "energy (RMS with a noise floor; the default) or silero (neural; needs a build with onnxruntime)."
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Config format version. Always 1."
    },
    "suites": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Globs of suite files that run and validate and list use when no paths are given."
    },
    "genkit": {
      "$ref": "#/$defs/Genkit"
    },
    "models": {
      "$ref": "#/$defs/Models"
    },
    "speech": {
      "$ref": "#/$defs/Speech"
    },
    "cache": {
      "$ref": "#/$defs/CacheConfig"
    },
    "sip": {
      "$ref": "#/$defs/SIPConfig"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets"
    },
    "livekit": {
      "$ref": "#/$defs/LiveKitConfig"
    },
    "baseline": {
      "$ref": "#/$defs/BaselineConfig"
    },
    "hooks": {
      "$ref": "#/$defs/Hooks",
      "description": "Setup and teardown for every suite; a suite's hooks run after the project's."
    },
    "reporters": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Reporters to run: console / junit / json / html / markdown / github / slack."
    },
    "slack": {
      "$ref": "#/$defs/SlackConfig"
    },
    "secrets": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object",
      "description": "Secret name to mamori ref (env:X or aws-sm://... or a precedence chain)."
    },
    "vars": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object",
      "description": "Project-wide values for {{vars.x}} and ${VAR} expansion in secret refs."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version"
  ],
  "title": "tamesu.yaml",
  "description": "tamesu project configuration. See https://xavidop.github.io/tamesu/docs/configuration/."
}
